# === Cleanup safety net (added 2026-05-09) ===
# Prevent debugging clutter from accumulating

# Old Next.js build caches
.next.backup-*
.next.broken-*
.next.build-*
.next.stale-*

# Code backups
*.bak
*.bak.*
backups/

# Python bytecode
__pycache__/
*.pyc

# Local data snapshots
.admin-data/
.snapshots/
reports/

# Common system junk
.DS_Store
Thumbs.db
tsconfig.tsbuildinfo

# Personalization worker runtime logs
scripts/personalization/pool-worker.log

# symlinked node_modules (worktrees) — trailing-slash pattern above misses symlinks
