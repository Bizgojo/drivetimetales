[Unit]
Description=Endless Tales web app (app.endless-tales.com / ec2.endless-tales.com via Caddy -> localhost:3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/drivetimetales
# Call next directly (not via `npm start`, which wraps it in an extra
# sh -c layer). The npm/sh wrapper let the actual next-server survive
# as an orphaned grandchild on SIGTERM, holding port 3000 and making
# every restart attempt fail with EADDRINUSE (found 2026-10-12).
ExecStart=/usr/bin/env node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5
KillMode=control-group
Environment=NODE_ENV=production
Environment=PORT=3000
StandardOutput=append:/home/ubuntu/drivetimetales/scripts/ec2-deploy/webapp.log
StandardError=append:/home/ubuntu/drivetimetales/scripts/ec2-deploy/webapp.log

[Install]
WantedBy=multi-user.target
