[Unit]
Description=Endless Tales run-next loop (Phase 1 autonomy — HOLD until Marc's go-live word)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/et-current
ExecStart=/usr/bin/env bash /home/ubuntu/et-current/scripts/ec2-deploy/run-next-loop.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/drivetimetales/scripts/ec2-deploy/run-next-loop.log
StandardError=append:/home/ubuntu/drivetimetales/scripts/ec2-deploy/run-next-loop.log

[Install]
WantedBy=multi-user.target
