[Unit]
Description=Endless Tales personalization pool worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/drivetimetales
ExecStart=/usr/bin/env node /home/ubuntu/drivetimetales/scripts/personalization/pool-worker.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=append:/home/ubuntu/drivetimetales/scripts/personalization/pool-worker.log
StandardError=append:/home/ubuntu/drivetimetales/scripts/personalization/pool-worker.log

[Install]
WantedBy=multi-user.target
