[Unit]
Description=Endless Tales local render worker (Path 2 — render_final_mix, 80+ segment stories)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/drivetimetales
ExecStart=/usr/bin/env node /home/ubuntu/drivetimetales/scripts/render-worker/render-worker.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=append:/home/ubuntu/drivetimetales/scripts/render-worker/render-worker.log
StandardError=append:/home/ubuntu/drivetimetales/scripts/render-worker/render-worker.log

[Install]
WantedBy=multi-user.target
